              <ns1:ctr name="GeneralConfiguration" type="IDENTIFIABLE">
                <ns1:var name="PlatformDevErrorDetect" type="BOOLEAN" value="true">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformMcmConfigurable" type="BOOLEAN" value="false">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformMpuConfigurable" type="BOOLEAN" value="false">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformIpAPIsAvailable" type="BOOLEAN" value="true">
                  </ns1:var>
                <ns1:var name="PlatformEnableUserModeSupport" type="BOOLEAN" value="false">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformMulticoreSupport" type="BOOLEAN" value="false">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformEnableVtorConfiguration" type="BOOLEAN" value="false">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="PlatformEnableIntCtrlConfiguration" type="BOOLEAN" value="true">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:lst name="PlatformEcucPartitionRef" />
              </ns1:ctr>
              <ns1:lst name="McmConfig" type="MAP" />
              <ns1:ctr name="Mpu_Configuration" type="IDENTIFIABLE">
                <ns1:lst name="MpuRegionConfig" type="MAP" />
              </ns1:ctr>
              <ns1:lst name="IntCtrlConfig" type="MAP">
                <ns1:ctr name="IntCtrlConfig" type="IDENTIFIABLE">
                  <ns1:lst name="PlatformIsrConfig" type="MAP">
                    <ns1:ctr name="Hsp_UartInterrupt" type="IDENTIFIABLE">
                      <ns1:var name="IsrName" type="ENUMERATION" value="LPUART1_RxTx_IRQn" />
                      <ns1:var name="IsrEnabled" type="BOOLEAN" value="true" />
                      <ns1:var name="IsrPriority" type="INTEGER" value="6" />
                      <ns1:var name="IsrHandler" type="FUNCTION-NAME" value="LPUART_UART_IP_1_IRQHandler" />
                    </ns1:ctr>
                    <ns1:ctr name="Hsp_ADC0_IRQn" type="IDENTIFIABLE">
                      <ns1:var name="IsrName" type="ENUMERATION" value="ADC0_IRQn" />
                      <ns1:var name="IsrEnabled" type="BOOLEAN" value="false" />
                      <ns1:var name="IsrPriority" type="INTEGER" value="6" />
                      <ns1:var name="IsrHandler" type="FUNCTION-NAME" value="Adc_0_Isr" />
                    </ns1:ctr>
                    <ns1:ctr name="Hsp_LPIT0_Ch0_IRQn" type="IDENTIFIABLE">
                      <ns1:var name="IsrName" type="ENUMERATION" value="LPIT0_Ch0_IRQn" />
                      <ns1:var name="IsrEnabled" type="BOOLEAN" value="true" />
                      <ns1:var name="IsrPriority" type="INTEGER" value="6" />
                      <ns1:var name="IsrHandler" type="FUNCTION-NAME" value="LPIT_0_CH_0_ISR" />
                    </ns1:ctr>
                    <ns1:ctr name="Ambd_ADC1" type="IDENTIFIABLE">
                      <ns1:var name="IsrName" type="ENUMERATION" value="ADC1_IRQn" />
                      <ns1:var name="IsrEnabled" type="BOOLEAN" value="true" />
                      <ns1:var name="IsrPriority" type="INTEGER" value="6" />
                      <ns1:var name="IsrHandler" type="FUNCTION-NAME" value="Ambd_KitAdcIrq" />
                    </ns1:ctr>
                    <ns1:ctr name="Ambd_GdFault" type="IDENTIFIABLE">
                      <ns1:var name="IsrName" type="ENUMERATION" value="PORTE_IRQn" />
                      <ns1:var name="IsrEnabled" type="BOOLEAN" value="true" />
                      <ns1:var name="IsrPriority" type="INTEGER" value="5" />
                      <ns1:var name="IsrHandler" type="FUNCTION-NAME" value="Ambd_KitFaultIrq" />
                    </ns1:ctr>
                  </ns1:lst>
                  <ns1:ref name="PlatformNvicEcucPartitionRef" type="REFERENCE">
                    <ns2:a name="ENABLE" value="false" />
                  </ns1:ref>
                  <ns1:var name="PlatformVtorAddressConfig" type="INTEGER" value="0" />
                </ns1:ctr>
              </ns1:lst>
              <ns1:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <ns1:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
