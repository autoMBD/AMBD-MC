                </ns1:var>
                <ns1:var name="ArReleaseMinorVersion" type="INTEGER" value="7">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="ArReleaseRevisionVersion" type="INTEGER" value="0">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="ModuleId" type="INTEGER" value="255">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="SwMajorVersion" type="INTEGER" value="3">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="SwMinorVersion" type="INTEGER" value="0">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="SwPatchVersion" type="INTEGER" value="0">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="VendorApiInfix" type="STRING" value="">
                  <ns2:a name="ENABLE" value="false" />
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
                <ns1:var name="VendorId" type="INTEGER" value="43">
                  <ns2:a name="IMPORTER_INFO" value="@DEF" />
                </ns1:var>
              </ns1:ctr>
            </ns1:ctr>
          </ns1:chc>
        </ns1:lst>
      </ns1:ctr>
    </ns1:lst>
  </ns1:ctr>
</ns0:datamodel>