<?xml version='1.0' encoding='utf-8'?>
<ns0:datamodel xmlns:ns0="http://www.tresos.de/_projects/DataModel2/16/root.xsd" xmlns:ns1="http://www.tresos.de/_projects/DataModel2/06/data.xsd" xmlns:ns2="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" version="7.0">
  <ns1:ctr type="AUTOSAR" factory="autosar">
    <ns1:lst type="TOP-LEVEL-PACKAGES">
      <ns1:ctr name="Platform" type="AR-PACKAGE">
        <ns1:lst type="ELEMENTS">
          <ns1:chc name="Platform" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <ns1:ctr type="MODULE-CONFIGURATION">
              <ns2:a name="DEF" value="ASPath:/TS_T40D2M30I0R0/Platform" />
              <ns1:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" value="VariantPreCompile">
                <ns2:a name="IMPORTER_INFO" value="@DEF" />
